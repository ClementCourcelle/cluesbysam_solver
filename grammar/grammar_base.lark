// =================== Sub-rules ===================

_super_pos: ngh_a | pos

pos: "in" AXIS COORD                  -> in_axis
   | "neighboring" NAME               -> neighboring_name
   | "on the edges"                   -> on_the_edges
   | "in" ("a" | "the") "corner" "s"? -> in_a_corner
   | "in between" NAME "and" NAME     -> in_between_names
   | _dir NAME                        -> dir_of_name

ngh_a: _name_s _NGH -> neighboring_name

_name_s: NAME "'s" | MY

_nb_no: _nb | NO

_nb: "exactly"? "only"? NB

_directly_dir_them: "directly" _dir "them"

_dir: DIR | "to the" DIR "of"

_role: "us"? ROLE "s"?

// JOB is injected at runtime — see load_parser() in main.py
_job: "us"? JOB "s"?

// =================== Terminals ===================
// NAME are injected at runtime — see load_parser() in main.py

_A_DET: "a" | "an"
_BE: "is" | "are"
_HAVE: "has" | "have"
_NGH: "neighbor" "s"?
_THERE: "there is" | "there are" | "there's"
_PERSON: "person" "s"? 

ALLBOTH: "all" | "both"
AXIS: /[Rr]ows?|[Cc]olumns?/
COORD: /[1-5]|[a-dA-D]/
DIR: "left" | "right" | "above" | "below"
MY: "my"
NB: /(?:exactly\s+|only\s+)?(?:one|[1-9][0-9]*)/
NO: "no"
PARITY: "even" | "odd"
ROLE: "innocent" | "criminal"

%ignore /\s+/
